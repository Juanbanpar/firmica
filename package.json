{
  "name": "firmica-interop-tests",
  "private": true,
  "scripts": {
    "test:lifecycle": "node --test tests/interop/lifecycle.test.mjs",
    "test:os-handler": "FIRMICA_OS_HANDLER=1 dbus-run-session -- xvfb-run -a -s '-screen 0 1280x900x24' node --test tests/interop/autoscript.test.mjs",
    "test:native-interop": "FIRMICA_NATIVE_INTEROP=1 node --test tests/interop/autoscript.test.mjs",
    "test:desktop": "node --test tests/interop/desktop.test.mjs",
    "test:autoscript": "node --test tests/interop/autoscript.test.mjs"
  },
  "devDependencies": { "playwright": "1.64.1" }
}
