<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:hasCode="true" android:icon="@mipmap/ic_launcher"
        android:extractNativeLibs="true" android:allowNativeHeapPointerTagging="false"
        android:label="Firmica" android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config">
        <!-- Retain the Dioxus/Wry activity; singleTask delivers warm URLs to onNewIntent. -->
        <activity android:name="dev.dioxus.main.MainActivity" android:exported="true"
            android:label="Firmica" android:launchMode="singleTask"
            android:configChanges="orientation|screenLayout|screenSize|keyboardHidden">
            <meta-data android:name="android.app.lib_name" android:value="main" />
            <meta-data android:name="android.app.func_name" android:value="ANativeActivity_onCreate" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="afirma" />
            </intent-filter>
        </activity>
    </application>
</manifest>
